# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=sqlite:///./sams.db
# DATABASE_URL=postgresql+psycopg2://sams:sams@localhost:5432/sams
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Optional - enables LLM-generated insights; without it the rule-based engine is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
