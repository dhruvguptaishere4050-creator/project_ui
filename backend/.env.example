# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=sqlite:///./sams.db
# DATABASE_URL=postgresql+psycopg2://sams:sams@localhost:5432/sams
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://.*\.example\.com

# Serve the built SPA from the API (single-origin deployment).
# STATIC_DIR=../frontend/dist
# Demo/staging only: seeds the demo dataset when the database is empty.
SEED_DEMO_DATA=false

# Optional - enables LLM-generated insights; without it the rule-based engine is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
